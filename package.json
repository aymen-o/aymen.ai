{
  "name": "aymen-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-build.mjs && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "audit": "npm audit --audit-level=low",
    "qa:site": "node scripts/check-site.mjs",
    "test:deployment": "node --test scripts/verify-deployment.test.mjs",
    "validate": "npm run check && npm run test:deployment && npm run build && npm run qa:site"
  },
  "author": "Aymen El Akbari",
  "license": "MIT",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^1.9.4",
    "parse5": "7.3.0",
    "typescript": "^5.9.3"
  }
}
