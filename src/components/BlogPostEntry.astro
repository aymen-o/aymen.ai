---
interface Props {
	title: string;
	date: Date;
	readingTime: string;
	tags?: string[];
	slug: string;
}

const { title, date, readingTime, tags = [], slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
	month: 'short',
	year: 'numeric',
});
---

<a href={`/blog/${slug}`} class="group block py-3">
	<div class="flex items-baseline justify-between gap-4">
		<h3 class="font-mono text-sm font-medium group-hover:underline underline-offset-4">
			{title}
		</h3>
		<span class="shrink-0 font-mono text-xs text-text-secondary">
			{readingTime} · {formattedDate}
		</span>
	</div>
	{tags.length > 0 && (
		<div class="mt-1 flex gap-2">
			{tags.map((tag: string) => (
				<span class="font-mono text-xs text-text-secondary">#{tag}</span>
			))}
		</div>
	)}
</a>
