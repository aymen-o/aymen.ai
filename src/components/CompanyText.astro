---
import { type Locale } from '../lib/i18n';
interface Props { text: string; locale?: Locale; preview?: boolean; }
const { text, locale = 'en', preview = false } = Astro.props;
const companies: Record<string, string> = {
  'Inworld AI': 'https://inworld.ai/',
  Inworld: 'https://inworld.ai/',
  Looka: 'https://looka.com/',
  'Eddyfi Technologies': 'https://eddyfi.com/',
  Eddyfi: 'https://eddyfi.com/',
  ESAB: 'https://esab.com/',
  'Bloc Solutions': `https://www.bloc.solutions/${locale === 'fr' ? 'fr' : 'en'}`,
};
const parts = text.split(/(Inworld AI|Inworld|Looka|Eddyfi Technologies|Eddyfi|ESAB|Bloc Solutions)/g);
const brands: Record<string, string> = {
  'Inworld AI': 'inworld', Inworld: 'inworld', Looka: 'looka',
  'Eddyfi Technologies': 'eddyfi', Eddyfi: 'eddyfi', ESAB: 'esab', 'Bloc Solutions': 'bloc',
};
---
{parts.map((part, index) => {
  if (!companies[part]) return preview && companies[parts[index - 1]] ? part.replace(/^[.,،؛:]/, '') : part;
  if (!preview) return <a class="company-link" href={companies[part]} target="_blank" rel="noopener noreferrer"><bdi>{part}</bdi></a>;
  return <span class="company-mention"><a
    class="company-link company-badge"
    href={companies[part]} target="_blank" rel="noopener noreferrer"
    data-brand={brands[part]}
    data-company-snapshot={`/images/companies/${brands[part]}${brands[part] === 'bloc' && locale === 'fr' ? '-fr' : ''}-preview.webp`}
  ><bdi dir="ltr"><img src={`/images/companies/${brands[part]}-icon.png`} alt="" width="18" height="18" decoding="async" />{part}</bdi></a>{parts[index + 1]?.match(/^[.,،؛:]/)?.[0]}</span>;
})}
<style>
  .company-link { color: var(--text); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .company-link:hover { text-decoration-color: currentColor; }
  .company-mention { display: inline-block; white-space: nowrap; }
  .company-badge { --brand-tint: #afb3bc; display: inline-flex; align-items: center; vertical-align: baseline; padding: .06em .36em; border-radius: 4px; line-height: 1.45; color: var(--text); text-decoration: none; background: color-mix(in srgb, var(--brand-tint) 15%, var(--bg)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand-tint) 12%, transparent); white-space: nowrap; }
  .company-badge[data-brand="inworld"] { --brand-tint: #c1ada1; }
  .company-badge[data-brand="looka"] { --brand-tint: #9c7de5; }
  .company-badge[data-brand="bloc"] { --brand-tint: #42aa97; }
  .company-badge[data-brand="eddyfi"] { --brand-tint: #cd963a; }
  .company-badge[data-brand="esab"] { --brand-tint: #d7b936; }
  .company-badge bdi { display: inline-flex; align-items: center; gap: .3em; }
  .company-badge img { display: inline-block; flex: none; width: 1em; height: 1em; object-fit: contain; border-radius: 2px; }
  .company-badge:hover, .company-badge:focus-visible { background: color-mix(in srgb, var(--brand-tint) 24%, var(--bg)); }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .company-badge { transition: background-color 150ms ease, transform 150ms ease; }
    .company-badge img { transition: transform 150ms ease; }
    .company-badge:hover { transform: translateY(-1px); }
    .company-badge:hover img { transform: rotate(-7deg) scale(1.08); }
  }
  @media (forced-colors: active) { .company-badge { outline: 1px solid LinkText; color: LinkText; } }
</style>
