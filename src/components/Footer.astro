---
import { SITE, AUTHOR, SOCIAL_LINKS } from '../lib/constants';
import { getCopy, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
---
<footer class="mt-16 border-t border-border">
  <div class="mx-auto flex max-w-2xl flex-col items-start gap-5 px-6 py-12">
    <a href={`mailto:${SITE.email}`} dir="ltr" class="font-mono text-sm underline-offset-4 hover:underline">{SITE.email}</a>
    <nav aria-label={copy.common.contact} class="flex flex-wrap gap-x-6 gap-y-2">
      {SOCIAL_LINKS.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-mono text-xs text-text-secondary hover:text-text">{link.name}<span aria-hidden="true" class="ms-1">↗</span></a>)}
    </nav>
    <p class="font-mono text-xs text-text-secondary">© {new Date().getUTCFullYear()} <bdi>{AUTHOR.name}</bdi></p>
  </div>
</footer>
