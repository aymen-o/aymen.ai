---
interface Props { name: string; size?: number; class?: string; strokeWidth?: number; }
const { name, size = 20, class: className, strokeWidth = 1.65 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={className}>
  {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><path d="M2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></>}
  {name === 'github' && <><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.6a3.1 3.1 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.8A5.3 5.3 0 0 0 18.8 5a4.9 4.9 0 0 0-.1-3.6S17.6 1 15 2.8a13.3 13.3 0 0 0-6 0C6.4 1 5.3 1.4 5.3 1.4A4.9 4.9 0 0 0 5.2 5a5.3 5.3 0 0 0-1.4 4.2c0 5.3 3.1 6.5 6.1 6.8a3.1 3.1 0 0 0-.9 2.4V22"/></>}
  {name === 'x' && <><path d="m4 4 11.7 16H20L8.3 4Z"/><path d="m4 20 6.8-6.8M13.2 10.8 20 4"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></>}
  {name === 'moon' && <path d="M20.9 13.1A9 9 0 0 1 10.9 3a9 9 0 1 0 10 10.1Z"/>}
  {name === 'home' && <><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="M9 21v-8h6v8"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2"/></>}
  {name === 'work' && <><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a21 21 0 0 0 18 0M10 12h4"/></>}
  {name === 'command' && <path d="M8 8V5.5A2.5 2.5 0 1 0 5.5 8H16a2.5 2.5 0 1 0 0-2.5V18.5a2.5 2.5 0 1 0 2.5-2.5H5.5A2.5 2.5 0 1 0 8 18.5Z"/>}
  {name === 'search' && <><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></>}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6"/>}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'arrow-up-right' && <path d="M6 18 18 6M6 6h12v12"/>}
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6"/>}
</svg>
