---
// data-reveal animates once; data-stagger animates a wrapper's direct children.
---
<div class="pointer-glow" data-pointer-glow aria-hidden="true"></div>
<style>
  .pointer-glow { position: fixed; top: 0; left: 0; width: 600px; height: 600px; z-index: -1; border-radius: 50%; pointer-events: none; opacity: 0; background: radial-gradient(circle, color-mix(in srgb, var(--text) 4%, transparent), transparent 67%); transition: opacity 350ms ease; }
  .pointer-glow[data-active] { opacity: 1; }
  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse), (forced-colors: active) { .pointer-glow { display: none; } }
</style>
<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const played = new WeakSet<Element>();
  const animations = new Set<Animation>();
  const stagger = new Map<Element, number>();
  let observer: IntersectionObserver | undefined;

  const reveal = (element: HTMLElement) => {
    if (played.has(element)) return;
    played.add(element);
    if (reduced.matches || typeof element.animate !== 'function') return;
    const animation = element.animate(
      [{ opacity: 0, translate: '0 12px' }, { opacity: 1, translate: '0 0' }],
      { duration: 600, delay: stagger.get(element) || 0, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' },
    );
    animations.add(animation);
    animation.addEventListener('finish', () => animations.delete(animation), { once: true });
    animation.addEventListener('cancel', () => animations.delete(animation), { once: true });
  };

  const initializeReveal = () => {
    observer?.disconnect();
    if (reduced.matches) { animations.forEach(animation => animation.cancel()); return; }
    const targets = new Set<HTMLElement>(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    document.querySelectorAll<HTMLElement>('[data-stagger]').forEach(group => {
      const interval = Math.max(0, Math.min(Number(group.dataset.stagger) || 70, 140));
      const children = Array.from(group.children).filter((element): element is HTMLElement => element instanceof HTMLElement && element.getAttribute('aria-hidden') !== 'true' && !['SCRIPT', 'STYLE'].includes(element.tagName));
      children.forEach((element, index) => { targets.add(element); stagger.set(element, Math.min(index * interval, 420)); });
    });
    if (!('IntersectionObserver' in window)) { targets.forEach(reveal); return; }
    observer = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) { reveal(entry.target as HTMLElement); observer?.unobserve(entry.target); } });
    }, { threshold: .08 });
    targets.forEach(element => { if (!played.has(element)) observer?.observe(element); });
  };

  const glow = document.querySelector<HTMLElement>('[data-pointer-glow]');
  let frame = 0;
  let x = 0;
  let y = 0;
  const stopPointer = () => {
    if (frame) cancelAnimationFrame(frame);
    frame = 0;
    glow?.removeAttribute('data-active');
  };
  document.addEventListener('pointermove', event => {
    if (!glow || reduced.matches || !finePointer.matches || event.pointerType === 'touch') return;
    x = event.clientX;
    y = event.clientY;
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      glow.style.transform = `translate3d(${x - 300}px, ${y - 300}px, 0)`;
      glow.setAttribute('data-active', '');
    });
  }, { passive: true });
  document.addEventListener('pointerout', event => { if (event.relatedTarget === null) stopPointer(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) stopPointer(); });
  finePointer.addEventListener('change', stopPointer);
  reduced.addEventListener('change', () => { stopPointer(); initializeReveal(); });
  initializeReveal();
</script>
