---
import ThemeToggle from './ThemeToggle.astro';
import { getCopy, locales, localeNames, localizedPath, stripLocale, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
const current = stripLocale(Astro.url.pathname);
const isNotFound = current.startsWith('/404');
const path = isNotFound ? '/' : current;
const items = [{ label: copy.nav.home, path: '/' }, { label: copy.nav.about, path: '/about/' }, { label: copy.nav.projects, path: '/projects/' }];
const labels = { en: 'EN', fr: 'FR', ar: 'ع' };
const active = (href: string) => !isNotFound && (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="header-shell">
    <a href={localizedPath(locale)} class="personal-mark" aria-label={`Aymen El Akbari · ${copy.nav.home}`}><bdi dir="ltr">ay<span aria-hidden="true">.</span></bdi></a>
    <nav class="primary-nav" aria-label={copy.nav.label}>
      {items.map(item => <a href={localizedPath(locale, item.path)} aria-current={active(item.path) ? 'page' : undefined} class="nav-link">{item.label}</a>)}
    </nav>
    <div class="header-controls">
      <nav class="language-links" aria-label={copy.nav.language}>
        {locales.map(lang => <a href={localizedPath(lang, path)} lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} hreflang={lang} aria-current={lang === locale ? 'true' : undefined} aria-label={localeNames[lang]} title={localeNames[lang]}>{labels[lang]}</a>)}
      </nav>
      <span class="control-divider" aria-hidden="true"></span>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; inset-block-start: 0; z-index: 50; border-block-end: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .header-shell { max-width: 48rem; margin-inline: auto; padding: .65rem 1.5rem; display: grid; grid-template-columns: auto 1fr auto; align-items: center; column-gap: 2rem; }
  .personal-mark { font-family: var(--font-mono); font-size: 1.25rem; font-weight: 600; letter-spacing: -.09em; min-height: 44px; display: inline-flex; align-items: center; color: var(--text); }
  .personal-mark span { color: var(--text-secondary); transition: color 180ms ease; }
  .personal-mark:hover span { color: var(--text); }
  .primary-nav { display: flex; align-items: center; gap: 1.25rem; }
  .nav-link { position: relative; display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-mono); font-size: .75rem; color: var(--text-secondary); transition: color 180ms ease; white-space: nowrap; }
  .nav-link:hover, .nav-link:focus-visible, .nav-link[aria-current='page'] { color: var(--text); }
  .nav-link::after { content: ''; position: absolute; inset-block-end: 3px; inset-inline-start: calc(50% - 2px); width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: 0; transform: translateY(3px); transition: transform 200ms ease, opacity 200ms ease; }
  .nav-link[aria-current='page']::after { opacity: 1; transform: translateY(0); }
  .header-controls, .language-links { display: flex; align-items: center; }
  .header-controls { gap: .3rem; }
  .language-links { gap: .15rem; }
  .language-links a { min-width: 30px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: .625rem; color: var(--text-secondary); border-radius: 5px; transition: color 180ms ease, background-color 180ms ease; }
  .language-links a[lang='ar'] { font-family: var(--font-arabic); font-size: .85rem; }
  .language-links a:hover, .language-links a:focus-visible { color: var(--text); background: color-mix(in srgb, var(--text) 4%, transparent); }
  .language-links a[aria-current] { color: var(--text); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .control-divider { width: 1px; height: 14px; background: var(--border); margin-inline: .1rem; }
  :global([lang='ar']) .nav-link { font-family: var(--font-arabic); font-size: .8rem; }
  @media (max-width: 520px) {
    .header-shell { padding: .4rem 1rem; column-gap: .75rem; grid-template-columns: auto 1fr; }
    .personal-mark { grid-column: 1; grid-row: 1; }
    .primary-nav { grid-column: 2; grid-row: 1; justify-content: flex-end; gap: 1.15rem; }
    .header-controls { grid-column: 1 / -1; grid-row: 2; justify-content: flex-end; margin-block-start: -.25rem; }
    .header-controls :global(.theme-toggle) { height: 36px; }
    .language-links a { min-height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .nav-link::after { transition: none; } }
</style>
