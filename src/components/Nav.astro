---
import ThemeToggle from './ThemeToggle.astro';
import { getCopy, locales, localeNames, localizedPath, stripLocale, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
const current = stripLocale(Astro.url.pathname);
const path = current.startsWith('/404') ? '/' : current;
const items = [
  { label: copy.nav.home, path: '/' }, { label: copy.nav.about, path: '/about/' },
  { label: copy.nav.blog, path: '/blog/' }, { label: copy.nav.projects, path: '/projects/' },
];
const active = (href: string) => !current.startsWith('/404') && (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header sticky top-0 z-50 border-b border-border bg-bg/95 backdrop-blur-lg">
  <div class="header-row mx-auto flex max-w-2xl items-center gap-3 px-6 py-3">
    <a href={localizedPath(locale)} class="brand me-auto font-mono text-sm font-bold tracking-tight"><bdi dir="ltr">aymen.ca</bdi></a>
    <nav class="desktop-nav items-center gap-5" aria-label={copy.nav.label}>
      {items.map(item => <a href={localizedPath(locale, item.path)} aria-current={active(item.path) ? 'page' : undefined} class="nav-link font-mono text-xs">{item.label}</a>)}
    </nav>
    <details class="language-picker relative">
      <summary aria-label={copy.nav.language} class="control font-mono text-xs"><span dir="ltr">{locale.toUpperCase()}</span><span aria-hidden="true">⌄</span></summary>
      <div class="language-options rounded-md border border-border bg-bg p-2 shadow-lg">
        {locales.map(lang => <a href={localizedPath(lang, path)} lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} hreflang={lang} aria-current={lang === locale ? 'true' : undefined} class="block rounded px-3 py-2 text-sm hover:bg-bg-secondary">{localeNames[lang]}</a>)}
      </div>
    </details>
    <ThemeToggle locale={locale} />
    <details class="mobile-nav">
      <summary class="control" aria-label={copy.nav.openMenu}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></summary>
      <nav class="mobile-panel border-b border-border bg-bg px-6 py-4" aria-label={copy.nav.label}>
        {items.map(item => <a href={localizedPath(locale, item.path)} aria-current={active(item.path) ? 'page' : undefined} class="nav-link block rounded-md px-3 py-3 font-mono text-sm hover:bg-bg-secondary">{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<style>
  .nav-link { color: var(--text-secondary); min-height: 44px; display: inline-flex; align-items: center; }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--text); }
  .desktop-nav .nav-link[aria-current='page'] { position: relative; }
  .desktop-nav .nav-link[aria-current='page']::after { content: ''; position: absolute; inset-block-end: 3px; inset-inline-start: calc(50% - 2px); width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .control { min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: .3rem; cursor: pointer; list-style: none; border-radius: 4px; }
  summary::-webkit-details-marker { display: none; }
  .control:hover { background: var(--bg-secondary); }
  .language-options { position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + .5rem); min-width: 130px; }
  .language-options a[aria-current] { text-decoration: underline; text-underline-offset: 4px; }
  .desktop-nav { display: flex; }
  .mobile-nav { display: none; }
  .mobile-panel { position: absolute; inset-inline: 0; inset-block-start: 100%; }
  .mobile-panel .nav-link { display: flex; }
  @media (max-width: 639px) { .desktop-nav { display: none; } .mobile-nav { display: block; } .header-row { gap: .25rem; } }
</style>
<script>
  // Native details keeps navigation available without JavaScript.
  const menus = document.querySelectorAll<HTMLDetailsElement>('.site-header details');
  menus.forEach(menu => {
    menu.addEventListener('toggle', () => { if (menu.open) menus.forEach(other => { if (other !== menu) other.open = false; }); });
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    menus.forEach(menu => { if (menu.open) { menu.open = false; menu.querySelector<HTMLElement>('summary')?.focus(); } });
  });
  document.addEventListener('click', event => {
    menus.forEach(menu => { if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  });
</script>
