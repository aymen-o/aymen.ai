---
import type { CollectionEntry } from 'astro:content';
import { formatDate, localizedPath, readingTime, type Locale } from '../lib/i18n';
interface Props { posts: CollectionEntry<'blog'>[]; locale: Locale; detailed?: boolean; }
const { posts, locale, detailed = false } = Astro.props;
const Heading = detailed ? 'h2' : 'h3';
---
<div>
  {posts.map(post => <a href={localizedPath(locale, `/blog/${post.data.translationKey}/`)} class="hover-row -mx-3 block rounded-lg px-3 py-4 transition-colors hover:bg-bg-secondary">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
      <Heading class="font-sans text-sm font-medium">{post.data.title}</Heading>
      <span class="shrink-0 font-mono text-xs text-text-secondary"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time><span aria-hidden="true"> · </span>{readingTime(post.body || '', locale)}</span>
    </div>
    {detailed && <p class="mt-2 text-sm leading-relaxed text-text-secondary">{post.data.description}</p>}
  </a>)}
</div>
