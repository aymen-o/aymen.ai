---
import { getCopy, type Locale } from '../lib/i18n';
interface Props { title: string; url: string; locale?: Locale; }
const { title, url, locale = 'en' } = Astro.props;
const copy = getCopy(locale);
---
<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-secondary">
  <span>{copy.common.share}</span>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center hover:text-text">LinkedIn</a>
  <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center hover:text-text">X</a>
  <button type="button" class="copy-link min-h-11 cursor-pointer hover:text-text" data-url={url} data-copied={copy.common.copied} data-failed={copy.common.copyFailed} hidden>{copy.common.copyLink}</button>
  <span class="copy-status basis-full text-xs" role="status" aria-live="polite"></span>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach(button => {
    if (!navigator.clipboard?.writeText) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector('.copy-status');
      try { await navigator.clipboard.writeText(button.dataset.url || location.href); if (status) status.textContent = button.dataset.copied || ''; }
      catch { if (status) status.textContent = button.dataset.failed || ''; }
    });
  });
</script>
