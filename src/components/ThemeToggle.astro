---
import Icon from './Icon.astro';
import { getCopy, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
---
<button type="button" class="theme-toggle" data-theme-toggle data-label-light={copy.theme.light} data-label-dark={copy.theme.dark} aria-label={copy.theme.label} title={copy.theme.label} hidden>
  <span class="theme-sun"><Icon name="sun" size={19} /></span>
  <span class="theme-moon"><Icon name="moon" size={19} /></span>
</button>
<style>
  .theme-toggle { position: relative; display: inline-grid; place-items: center; width: 40px; height: 44px; flex: 0 0 40px; border-radius: 8px; color: var(--text-secondary); cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover, .theme-toggle:focus-visible { color: var(--text); background: color-mix(in srgb, var(--text) 5%, transparent); }
  .theme-toggle span { position: absolute; display: flex; transition: opacity 250ms ease, transform 400ms cubic-bezier(.22,1,.36,1); }
  .theme-sun { opacity: 0; transform: rotate(-90deg) scale(.6); }
  .theme-moon { opacity: 1; transform: rotate(0) scale(1); }
  .theme-toggle[data-effective-theme='dark'] .theme-sun { opacity: 1; transform: rotate(0) scale(1); }
  .theme-toggle[data-effective-theme='dark'] .theme-moon { opacity: 0; transform: rotate(90deg) scale(.6); }
  .theme-toggle:hover .theme-sun { transform: rotate(25deg) scale(1); }
  .theme-toggle[data-effective-theme='light']:hover .theme-moon { transform: rotate(-15deg) scale(1); }
  @media (prefers-reduced-motion: reduce) { .theme-toggle span { transition: none; } }
</style>
<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const preference = window.matchMedia('(prefers-color-scheme: dark)');
  const effectiveTheme = () => document.documentElement.dataset.theme || (preference.matches ? 'dark' : 'light');
  const update = () => {
    const current = effectiveTheme();
    toggles.forEach(button => {
      button.dataset.effectiveTheme = current;
      const label = current === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
      button.setAttribute('aria-label', label || 'Theme');
      button.title = label || 'Theme';
      button.hidden = false;
    });
  };
  toggles.forEach(button => button.addEventListener('click', () => {
    const theme = effectiveTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    update();
  }));
  window.addEventListener('storage', event => {
    if (event.key !== 'theme' && event.key !== null) return;
    if (event.newValue === 'dark' || event.newValue === 'light') document.documentElement.dataset.theme = event.newValue;
    else delete document.documentElement.dataset.theme;
    update();
  });
  preference.addEventListener('change', update);
  update();
</script>
