---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCopy, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/constants';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
const skills = ['TypeScript', 'Vue.js', 'React', 'Node.js', 'C# / ASP.NET', 'Python', 'PHP', 'SQL', 'REST APIs', 'Docker'];
---
<PageLayout title={copy.about.title} description={copy.about.description} locale={locale}>
  <article>
    <div data-stagger><h1 class="text-3xl font-semibold tracking-tight">{copy.about.title}</h1>
    <div class="mt-6 space-y-4 leading-[1.8] text-text-secondary">{copy.about.intro.map(paragraph => <p>{paragraph}</p>)}</div></div>
    <section class="mt-12 border-t border-border pt-6" data-reveal>
      <h2 class="section-heading">{copy.about.workTitle}</h2>
      <div class="mt-4 space-y-4 leading-[1.8] text-text-secondary">{copy.about.work.map(paragraph => <p>{paragraph}</p>)}</div>
    </section>
    <section class="mt-12 border-t border-border pt-6" data-reveal>
      <h2 class="section-heading">{copy.about.experienceTitle}</h2>
      <ol class="timeline mt-6">{copy.about.experience.map(item => <li class="timeline-item" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><h3 class="font-mono text-sm font-semibold"><bdi>{item.company}</bdi></h3><p class="font-mono text-xs text-text-secondary">{item.period}</p></div>
        <p class="mt-1 text-sm">{item.role}</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.description}</p>
      </li>)}</ol>
    </section>
    <section class="mt-12 border-t border-border pt-6" data-reveal>
      <h2 class="section-heading">{copy.about.skillsTitle}</h2>
      <ul class="skills mt-4 flex flex-wrap gap-x-5 gap-y-3">{skills.map(skill => <li class="font-mono text-xs text-text-secondary"><bdi>{skill}</bdi></li>)}</ul>
    </section>
    <section class="mt-12 border-t border-border pt-6" data-reveal>
      <h2 class="section-heading">{copy.about.educationTitle}</h2>
      <div class="education mt-5">{copy.about.education.map(item => <div><h3 class="text-sm font-medium"><bdi>{item.school === 'Université Laval' ? 'uLaval' : item.school}</bdi></h3><p class="mt-1 text-sm text-text-secondary">{item.degree}</p>{item.period && <p class="mt-1 font-mono text-xs text-text-secondary"><bdi>{item.period}</bdi></p>}</div>)}</div>
    </section>
    <a href={`mailto:${SITE.email}`} class="mt-10 inline-flex min-h-11 items-center gap-2 font-mono text-sm underline underline-offset-4">{copy.common.contact}<span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>
  </article>
</PageLayout>
<style>
  .section-heading { font-size: .95rem; font-weight: 500; }
  .timeline-item { position: relative; border-inline-start: 1px solid var(--border); padding-inline-start: 1.5rem; padding-bottom: 2rem; }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-item::before { content: ''; position: absolute; inset-inline-start: -3.5px; top: .45rem; width: 6px; height: 6px; border-radius: 50%; background: var(--bg); border: 1px solid var(--text-secondary); }
  .timeline-item:first-child::before { background: var(--text-secondary); box-shadow: 0 0 0 4px var(--bg-secondary); }
  .education { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  @media (max-width: 480px) { .education { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
