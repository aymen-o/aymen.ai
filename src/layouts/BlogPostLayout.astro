---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { getCopy, localizedPath, readingTime, formatDate, type Locale } from '../lib/i18n';
interface Props { title: string; description: string; date: Date; updated?: Date; tags?: string[]; content: string; ogImage?: string; locale?: Locale; }
const { title, description, date, updated, tags = [], content, ogImage, locale = 'en' } = Astro.props;
const copy = getCopy(locale);
const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<BaseLayout title={title} description={description} ogImage={ogImage} locale={locale} article={{ published: date, updated }}>
  <Nav locale={locale} />
  <main id="main-content" tabindex="-1" class="mx-auto max-w-2xl px-6 py-12 sm:py-16">
    <article>
      <header class="mb-10">
        <a href={localizedPath(locale, '/blog/')} class="inline-flex min-h-11 items-center gap-2 font-mono text-sm text-text-secondary hover:text-text"><span aria-hidden="true">{locale === 'ar' ? '→' : '←'}</span>{copy.blog.back}</a>
        <h1 class="mt-4 font-mono text-2xl font-semibold leading-snug">{title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-text-secondary">
          <time datetime={date.toISOString()}>{formatDate(date, locale, { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          <span aria-hidden="true">·</span><span>{readingTime(content, locale)}</span>
        </div>
        {updated && <p class="mt-2 font-mono text-xs text-text-secondary">{copy.common.updated} <time datetime={updated.toISOString()}>{formatDate(updated, locale, { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>}
        {tags.length > 0 && <ul class="mt-3 flex flex-wrap gap-2">{tags.map(tag => <li class="font-mono text-xs text-text-secondary"><bdi>#{tag}</bdi></li>)}</ul>}
      </header>
      <div class="prose"><slot /></div>
      <footer class="mt-12 border-t border-border pt-6"><ShareLinks title={title} url={fullUrl} locale={locale} /></footer>
    </article>
  </main>
  <Footer locale={locale} />
</BaseLayout>
