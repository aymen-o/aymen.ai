---
import PageLayout from '../layouts/PageLayout.astro';
import { getCopy, locales, localeNames, localizedPath } from '../lib/i18n';
const copy = getCopy('en');
---
<PageLayout title="404" description={copy.notFound.description} noindex>
  <div class="flex min-h-[45vh] flex-col items-start justify-center">
    <h1 class="font-mono text-5xl font-bold">404</h1>
    <p class="mt-5 text-text-secondary">{copy.notFound.description}</p>
    <div class="mt-6 flex flex-wrap gap-4">{locales.map(locale => <a href={localizedPath(locale)} lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'} class="inline-flex min-h-11 items-center font-mono text-sm underline underline-offset-4">{getCopy(locale).common.backHome} <span class="sr-only">({localeNames[locale]})</span></a>)}</div>
  </div>
</PageLayout>
