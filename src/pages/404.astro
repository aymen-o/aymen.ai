---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404" description="Page not found.">
	<div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
		<h1 class="font-mono text-6xl font-bold">404</h1>
		<p class="mt-4 text-text-secondary">This page doesn't exist.</p>
		<a href="/" class="group mt-6 inline-flex items-center gap-1 font-mono text-sm text-text-secondary transition-colors duration-150 hover:text-text">
			<span class="transition-transform duration-200 group-hover:translate-x-1">→</span> back home
		</a>
	</div>
</PageLayout>
