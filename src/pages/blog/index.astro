---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../../lib/utils';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout title="Blog" description="Writing about web development, AI, and building products.">
	<h1 class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-text-secondary">* writing</h1>
	<p class="mt-3 text-text-secondary">
		Thoughts on web development, AI, and building products from Quebec City.
	</p>

	<div class="mt-8">
		{posts.map((post) => (
			<a
				href={`/blog/${post.id.replace(/\.md$/, '')}`}
				class="group hover-row -mx-3 block rounded-lg px-3 py-4 transition-all duration-150 hover:translate-x-1 hover:bg-[rgba(255,255,255,0.03)]"
			>
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="font-sans text-sm font-medium">{post.data.title}</h2>
					<span class="shrink-0 font-mono text-xs text-text-secondary">
						{calculateReadingTime(post.body || '')} · {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
					</span>
				</div>
				{post.data.tags.length > 0 && (
					<div class="mt-1.5 flex gap-2">
						{post.data.tags.map((tag: string) => (
							<span class="font-mono text-xs text-text-secondary">#{tag}</span>
						))}
					</div>
				)}
			</a>
		))}
	</div>
</PageLayout>
