---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../lib/utils';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

const projects = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

const statusColors: Record<string, string> = {
	active: 'bg-green-500',
	shipped: 'bg-gray-400',
	building: 'bg-orange-500',
	running: 'bg-blue-500',
	sunset: 'bg-gray-600',
	employed: 'bg-blue-400',
	exited: 'bg-purple-500',
};
---

<PageLayout>
	<!-- Hero -->
	<section class="relative flex min-h-[70vh] flex-col justify-center py-16">
		<div class="hero-content relative">
			<span
				class="arabic-name pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-[60%] select-none font-sans font-bold leading-none"
				aria-hidden="true"
				style="font-size: clamp(6rem, 15vw, 12rem); opacity: var(--arabic-opacity, 0.04);"
			>
				أيمن
			</span>
			<h1 class="hero-fade font-sans text-[clamp(2rem,5vw,3.5rem)] font-bold" style="animation-delay: 0ms">
				Aymen El Akbari
			</h1>
			<p class="hero-fade mt-4 text-[1.1rem] leading-[1.8] text-text-secondary" style="animation-delay: 80ms">
				SWE, full-stack developer &amp; entrepreneur.
			</p>
			<p class="hero-fade text-[1.1rem] leading-[1.8] text-text-secondary" style="animation-delay: 160ms">
				Building AI products from Quebec City.
			</p>
			<p class="hero-fade text-[1.1rem] leading-[1.8] text-text-secondary" style="animation-delay: 240ms">
				Currently shipping at <a href="https://www.eddyfi.com" target="_blank" rel="noopener noreferrer" class="font-medium text-text underline-offset-4 hover:underline">Eddyfi Technologies</a>.
			</p>

			<!-- Social icons -->
			<div class="hero-fade mt-6 flex items-center gap-4" style="animation-delay: 320ms">
				<a href="https://www.linkedin.com/in/aymen-el-akbari/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="opacity-50 transition-all duration-200 hover:opacity-100 hover:-translate-y-0.5">
					<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
				</a>
				<a href="https://x.com/aymenakx" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="opacity-50 transition-all duration-200 hover:opacity-100 hover:-translate-y-0.5">
					<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
				</a>
				<a href="https://github.com/aymen-o" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="opacity-50 transition-all duration-200 hover:opacity-100 hover:-translate-y-0.5">
					<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Blog Posts -->
	<section class="mt-8 reveal-on-scroll">
		<h2 class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-text-secondary">* writing</h2>
		<div class="mt-4">
			{posts.map((post) => (
				<a
					href={`/blog/${post.id.replace(/\.md$/, '')}`}
					class="group hover-row -mx-3 flex items-baseline justify-between gap-4 rounded-lg px-3 py-3 transition-all duration-150 hover:translate-x-1 hover:bg-[rgba(255,255,255,0.03)]"
				>
					<span class="font-sans text-sm font-medium">{post.data.title}</span>
					<span class="shrink-0 font-mono text-xs text-text-secondary">
						{calculateReadingTime(post.body || '')} · {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
					</span>
				</a>
			))}
		</div>
		<a href="/blog" class="view-all group mt-3 inline-flex items-center gap-1 font-mono text-sm text-text-secondary transition-colors duration-150 hover:text-text">
			<span class="transition-transform duration-200 group-hover:translate-x-1">→</span> all posts
		</a>
	</section>

	<!-- Projects -->
	<section class="mt-16 reveal-on-scroll">
		<h2 class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-text-secondary">* building</h2>
		<div class="mt-4">
			{projects.map((project) => {
				const dotColor = statusColors[project.data.status] || 'bg-gray-400';

				return (
					<div
						class:list={[
							'-mx-3 flex items-baseline justify-between gap-4 rounded-lg px-3 py-3 transition-all duration-150',
							project.data.url && 'hover-row hover:translate-x-1 hover:bg-[rgba(255,255,255,0.03)] cursor-pointer',
						]}
						onclick={project.data.url ? `window.open('${project.data.url}', '_blank')` : undefined}
					>
						<div class="min-w-0">
							<span class="font-mono text-sm font-bold">{project.data.title}</span>
							<span class="ml-2 text-sm text-text-secondary">{project.data.description}</span>
						</div>
						<span class="inline-flex shrink-0 items-center gap-1.5 font-mono text-xs text-text-secondary">
							<span class={`inline-block h-1.5 w-1.5 rounded-full ${dotColor}`}></span>
							{project.data.status}
						</span>
					</div>
				);
			})}
		</div>
		<a href="/projects" class="view-all group mt-3 inline-flex items-center gap-1 font-mono text-sm text-text-secondary transition-colors duration-150 hover:text-text">
			<span class="transition-transform duration-200 group-hover:translate-x-1">→</span> all projects
		</a>
	</section>
	<script>
		function initReveal() {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.1 });
			document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
		}

		function initCursorGlow() {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if ('ontouchstart' in window) return;

			const glow = document.createElement('div');
			glow.className = 'cursor-glow';
			document.body.appendChild(glow);

			document.addEventListener('mousemove', (e) => {
				glow.style.left = e.clientX + 'px';
				glow.style.top = e.clientY + 'px';
			});
		}

		initReveal();
		document.addEventListener('astro:page-load', initReveal);
		initCursorGlow();
	</script>
</PageLayout>
